---
const skills = {
  'Front-end': 'HTML, CSS, JavaScript, TypeScript, Angular, React, Next.js, ExtJS.',
  'Back-end':
    'C#, .NET Framework (4.6+), .NET Core (3.1+), .NET 6, .NET 7, .NET 8, .NET 9, ASP.NET Web Forms, ASP.NET MVC, ASP.NET Core, WCF, WPF, Java, Node.js, Express.js.',
  'APIs and architecture':
    'RESTful APIs, SOAP APIs, Minimal APIs, Clean Code, Clean Architecture, MVVM Architecture, DB Store Procedure Concept, DDD, SOLID, Design Patterns, CQRS, Microservices, Authentication, Authorization, Unit tests.',
  'ORMs, ODMs and Data Access': 'Entity Framework Core, Dapper, ADO.NET, ODP.NET, Prisma, Drizzle ORM, Mongoose.',
  'SQL databases': 'Microsoft SQL Server, PostgreSQL, MySQL, SQLite, Oracle.',
  'No-SQL databases': 'MongoDB.',
  'Version control': 'Git, TFS.',
  'CI/CD': 'GitHub Actions, TeamCity, Octopus Deploy, Docker.',
  Azure:
    'Azure DevOps, Azure Boards, Azure Repos, Azure Pipelines, Azure App Service, Azure Active Directory, Azure Key Vault, Azure Blob Storage.',
  AWS: 'S3.',
  Cloudflare: 'R2.',
  OCI: 'Object Storage.',
  Observability: 'Datadog.',
  'AI-assisted development': 'LLMs and AI agents such as Claude Code, Codex, DeepSeek and Gemini.',
  'Agile methodologies': 'Scrum, Kanban.',
};
---

<main>
  <section class="py-10 mx-auto w-full lg:py-14">
    <h2 class="text-2xl lg:text-3xl font-bold leading-tighter tracking-tighter mb-6 md:mb-7">
      Skills & Qualifications
    </h2>

    <div class="space-y-6 max-w-3xl">
      {
        Object.entries(skills).map(([category, items]) => (
          <div>
            <h3 class="text-lg font-semibold mb-1">{category}</h3>
            <p class="text-justify text-gray-700 dark:text-slate-300">{items}</p>
          </div>
        ))
      }
    </div>
  </section>
</main>
